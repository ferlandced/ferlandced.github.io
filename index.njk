---
layout: layouts/base.njk
bodyClass: home
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "/{{ lang }}/"
translated: true
---
{%- set t = i18n[lang] -%}
{%- set photo = home.hero_photo or agent.photo -%}
<main>
  {# The stage holds the hero and About. With motion allowed, the agent photo in .stage__track
     stays pinned while it travels from the hero into the About card, then scrolls up with About. #}
  <div class="stage">
    <section class="hero" aria-labelledby="hero-name">
      {# Stripes are decorative. The side image uses the CMS description; empty keeps it silent. #}
      <div class="hero__band">
        <span class="hero__stripe hero__stripe--red" aria-hidden="true"></span>
        <span class="hero__stripe hero__stripe--dark" aria-hidden="true"></span>
        {% if home.side_image %}<span class="hero__side"><img src="{{ home.side_image }}" alt="{{ home.side_image_alt }}"></span>{% endif %}
      </div>
      <div class="hero__inner">
        <div class="hero__id">
          {% if home.signature %}<img class="hero__signature" src="{{ home.signature }}" alt="" width="2160" height="1960">{% endif %}
          <h1 class="hero__name" id="hero-name">{{ agent.name }}</h1>
          <p class="hero__tagline">{{ t.hero.tagline }}</p>
          <p class="hero__role">{{ agent.title[lang] }}</p>
          <p class="hero__agency">{{ t.hero.agency }}{% if t.hero.area %}, {{ t.hero.area }}{% endif %}</p>
          {# One action: the estimation form, in a dialog with JS, on its own page without #}
          <p class="hero__cta"><a class="btn btn--solid" href="{{ site.pages.estimation[lang] }}" data-dialog="dialog-estimation">{{ t.hero.cta }}</a></p>
        </div>
      </div>
      {# Own layer so it can be cut along the slash on phones and tablets #}
      {% if photo %}<div class="hero__figure"><img class="hero__photo" src="{{ photo }}" alt="{{ home.hero_photo_alt }}" fetchpriority="high"></div>{% endif %}
    </section>

    {% if photo %}
    <div class="stage__track" aria-hidden="true">
      <div class="stage__pin">
        {# Backdrop behind the agent once he reaches About: CMS image, or a plain gray placeholder #}
        <div class="stage__backdrop"{% if home.about_backdrop %} style="background-image: url('{{ home.about_backdrop | url }}')"{% endif %}></div>
        <div class="stage__agent"><img src="{{ photo }}" alt=""></div>
      </div>
    </div>
    {% endif %}

    <section id="about" class="about">
      <div class="container about__inner">
        {# The agent's picture in About. When the travelling copy is active it stays invisible and
           only holds the space where the copy lands; otherwise (reduced motion) it shows as is. #}
        {% if photo %}<div class="about__card" aria-hidden="true"{% if home.about_backdrop %} style="background-image: url('{{ home.about_backdrop | url }}')"{% endif %}><img src="{{ photo }}" alt="" loading="lazy"></div>{% endif %}
        <div class="about__body">
          <h2>{{ t.about.heading }}</h2>
          {{ agent.bio[lang] | renderContent("md") | safe }}
          <ul class="about__contact">
            {% if agent.phone %}<li>{{ t.about.cellLabel }} <a href="tel:+1{{ agent.phone | replace(' ', '') }}">{{ agent.phone }}</a></li>{% endif %}
            {% if agent.email %}<li><a href="mailto:{{ agent.email }}">{{ agent.email }}</a></li>{% endif %}
          </ul>
          <p class="about__actions"><a class="btn" href="{{ site.pages.about[lang] }}">{{ t.about.more }}</a> <a class="btn" href="#contact">{{ t.about.contact }}</a></p>
        </div>
      </div>
    </section>
  </div>

  {# Trust strip: what is true today (OACIQ: advertising must be accurate and provable).
     The licence item shows only once the licence number is filled in (Agent profile in the CMS).
     Placed after About, not directly under the hero: the photo travels from the hero into About. #}
  <section class="trust" aria-label="{{ t.trust.label }}">
    <ul class="container trust__list">
      {% if agent.licence %}
      <li class="trust__item trust__item--licence">
        <p class="trust__title">{{ t.trust.licence }}</p>
        <p>{{ t.trust.licenceNumber }} {{ agent.licence }}{% if agent.licenceRegisterUrl %}<br><a href="{{ agent.licenceRegisterUrl }}">{{ t.trust.register }}</a>{% endif %}</p>
      </li>
      {% endif %}
      <li class="trust__item"><p class="trust__title">{{ t.trust.backingTitle }}</p><p>{{ t.trust.backingText }}</p></li>
      <li class="trust__item"><p class="trust__title">{{ t.trust.responseTitle }}</p><p>{{ t.trust.responseText }}</p></li>
      <li class="trust__item"><p class="trust__title">{{ t.trust.languagesTitle }}</p><p>{{ t.trust.languagesText }}</p></li>
    </ul>
  </section>

  <section id="services" class="services" aria-labelledby="services-heading">
    <div class="container">
      <h2 id="services-heading">{{ t.services.heading }}</h2>
      <ul class="services__list">
        {% for id in ["buy", "sell", "rent"] %}{% set s = t.services[id] %}
        <li class="service service--{{ id }}">
          <h3 class="service__title">{{ s.title }}</h3>
          <p class="service__text">{{ s.text }}</p>
          <div class="service__actions">
            {# Each button links to a form page (site.pages); with JS it opens the same form in a dialog below.
               Renting reuses the property alert and estimation forms with intent "location", which sets the
               form's hidden intent field and rental subject (js/forms.js). #}
            {% set actions = { buy: { action1: { form: "propertyAlert" } }, sell: { action1: { form: "estimation" } },
                               rent: { action1: { form: "propertyAlert", intent: "location" }, action2: { form: "estimation", intent: "location" } } } %}
            {% for key in ["action1", "action2"] %}{% set a = s[key] %}{% set act = actions[id][key] %}{% if a and a.label %}<a class="btn" href="{{ site.pages[act.form][lang] }}{% if act.intent %}?intent={{ act.intent }}{% endif %}" data-dialog="dialog-{{ act.form }}"{% if act.intent %} data-intent="{{ act.intent }}"{% endif %}>{{ a.label }}</a>{% endif %}{% endfor %}
          </div>
          <a class="service__more" href="{{ site.pages[id][lang] }}">{{ s.more }}</a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {% if collections.listings.length %}
  <section id="properties" class="properties" aria-labelledby="properties-heading">
    <div class="container">
      <h2 id="properties-heading">{{ t.properties.heading }}</h2>
      <div class="cards">
        {% for item in collections.listings | head(6) %}{% include "partials/listing-card.njk" %}{% endfor %}
      </div>
      <p><a class="btn" href="/listings/">{{ t.properties.all }}</a></p>
    </div>
  </section>
  {% endif %}

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="container contact__inner">
      <h2 id="contact-heading">{{ t.contact.heading }}</h2>
      <p>{{ t.contact.intro }}</p>
      {# Web3Forms: emails the submission to the agent. The access key is public by design (restrict it to the site domain). #}
      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-contact-form data-either-message="{{ t.contact.either }}">
        <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
        <input type="hidden" name="subject" value="{{ t.contact.subject }}">
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off">
        <div class="field">
          <label for="cf-name">{{ t.contact.name }}</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required>
        </div>
        <div class="contact-form__row">
          <div class="field">
            <label for="cf-email">{{ t.contact.email }}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" aria-describedby="cf-either">
          </div>
          <div class="field">
            <label for="cf-phone">{{ t.contact.phone }}</label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" aria-describedby="cf-either">
          </div>
        </div>
        <p class="contact-form__hint" id="cf-either">{{ t.contact.either }}</p>
        <div class="field">
          <label for="cf-message">{{ t.contact.message }}</label>
          <textarea id="cf-message" name="message" required></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="consent" value="yes" required>
          <span>{{ t.contact.consentBefore }}<a href="{{ site.pages.privacy[lang] }}">{{ t.contact.privacy }}</a>{{ t.contact.consentAfter }}</span>
        </label>
        <button class="btn" type="submit">{{ t.contact.submit }}</button>
      </form>
    </div>
  </section>

  {# Form dialogs, opened by the service buttons (see js/site.js). Full screen on phones. #}
  {% for formKey, formFile in { propertyAlert: "property-alert", estimation: "estimation" } %}
  <dialog class="form-dialog" id="dialog-{{ formKey }}" aria-labelledby="dialog-{{ formKey }}-title">
    {% set titleTag = "h2" %}{% set titleId = "dialog-" ~ formKey ~ "-title" %}
    {% include "partials/form-panel.njk" %}
  </dialog>
  {% endfor %}
</main>
<script src="/js/forms.js" defer></script>
