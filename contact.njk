---
layout: layouts/base.njk
bodyClass: page
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "{{ site.pages.contact[lang] }}"
translated: true
pageKey: contact
eleventyComputed:
  title: "{{ i18n[lang].contact.title }}"
---
{%- set t = i18n[lang] -%}
<main class="container contact-page">
  <div class="contact-page__photo">{% if t.contact.photo %}<img src="{{ t.contact.photo }}" alt="{{ t.contact.photoAlt }}">{% endif %}</div>
  <div class="contact-page__body">
    <h1>{{ t.contact.title }}</h1>
    {% include "partials/contact-options.njk" %}
  </div>
</main>
