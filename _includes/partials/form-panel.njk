{# Form card: title, close link and the form (_includes/forms/, text from content/forms.json).
   Expects formKey (key in site.pages and in forms.json), formFile (form template name), titleTag and titleId.
   Used by the form pages (h1, close goes home) and the home page dialogs (close shuts the dialog). #}
<div class="form-panel">
  <div class="form-panel__head">
    <{{ titleTag }} class="form-panel__title" id="{{ titleId }}">{{ t.forms[formKey].title }}</{{ titleTag }}>
    <a class="form-panel__close" href="/{{ lang }}/" data-close aria-label="{{ t.forms.common.close }}"><span data-icon="x" aria-hidden="true"></span></a>
  </div>
  {% if t.forms[formKey].intro %}<p class="form-panel__next">{{ t.forms[formKey].intro }}</p>{% endif %}
  {% include "forms/" + formFile + ".njk" %}
</div>
