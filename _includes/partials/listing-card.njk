<a class="card" href="{{ item.url }}">
  {% if item.data.photos and item.data.photos[0] %}<img class="card__img" src="{{ item.data.photos[0] }}" alt="" loading="lazy">{% else %}<div class="card__img card__img--empty"></div>{% endif %}
  <div class="card__body">
    {% if item.data.status %}<span class="listing__status">{{ item.data.status }}</span>{% endif %}
    <h3 class="card__title">{{ item.data.title }}</h3>
    <p class="card__meta">{{ item.data.neighbourhood or item.data.address }}</p>
    <p class="card__price">{{ item.data.price | money }}</p>
  </div>
</a>
