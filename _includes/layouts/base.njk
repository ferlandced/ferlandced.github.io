<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ agent.name }}</title>
  <meta name="description" content="{{ description or home.subtitle }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Allura&family=Barlow+Condensed:wght@500;600&family=Manrope:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body class="{{ bodyClass }}">
  {% include "partials/header.njk" %}
  {{ content | safe }}
  {% include "partials/footer.njk" %}
</body>
</html>
